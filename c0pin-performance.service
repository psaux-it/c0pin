[Unit]
Description=c0pin CPU performance policy tuner
After=sysinit.target
Conflicts=c0pin-aggressive.service

ConditionPathExists=/sys/devices/system/cpu/cpufreq

StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/c0pin --performance-policy

SuccessExitStatus=0

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateNetwork=true

NoNewPrivileges=true
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_SYS_ADMIN

LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
MemoryDenyWriteExecute=true

ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true

RestrictAddressFamilies=
RestrictNamespaces=true

SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @raw-io @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

UMask=0077

[Install]
WantedBy=multi-user.target
